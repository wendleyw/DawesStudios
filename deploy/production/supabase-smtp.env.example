# Merge these values into the installed official Supabase Docker distribution's .env.
# This is a fragment, not an application .env file or a complete Supabase configuration.
# Replace both placeholders after verifying the sending domain in Resend.
SMTP_ADMIN_EMAIL=no-reply@auth.example.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=replace-with-resend-api-key
SMTP_SENDER_NAME="Brianna Dawes Studios"
ENABLE_EMAIL_AUTOCONFIRM=false
