NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-or-hosted-public-anon-key
NEXT_PUBLIC_MEDIA_URL=http://127.0.0.1:55430
# Server-only credential required for invitation emails. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-or-hosted-service-role-key
# Optional: a Meta Ad Library API token for in-app competitor ad previews. Server-only; never use a
# NEXT_PUBLIC_ prefix. A long-lived user token lasts about 60 days. Without it, the competitor
# screen keeps its library links and says previews are off.
META_AD_LIBRARY_ACCESS_TOKEN=
# Optional: comma-separated ISO country codes for the preview search. Empty means every country.
META_AD_LIBRARY_COUNTRIES=
