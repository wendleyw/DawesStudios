# Browser values are embedded at build time. Rebuild after changing them.
NEXT_PUBLIC_SUPABASE_URL=https://api.example.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-the-public-anon-key
NEXT_PUBLIC_MEDIA_URL=https://media.example.com

# Optional image references for release/rollback. Set both to immutable digest references
# (registry.example.com/dawes-web@sha256:...) after building and publishing images.
WEB_IMAGE=dawes-studios-web:local
MEDIA_IMAGE=dawes-studios-media:local

# These remain on the server. Use the same Supabase deployment through its PRIVATE gateway.
# The public edge blocks Auth admin paths used by invitation/removal routes.
SUPABASE_INTERNAL_URL=http://host.docker.internal:8000
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-private-service-role-key
APP_ORIGIN=https://app.example.com
# Further browser origins the media service answers, comma separated. Leave empty in
# production; a development machine adds the ports it serves the application from.
MEDIA_ALLOWED_ORIGINS=
WEB_PORT=3003
MEDIA_PORT=55430
# Optional competitor ad previews (docs/operations/production.md). Empty disables them.
META_AD_LIBRARY_ACCESS_TOKEN=
META_AD_LIBRARY_COUNTRIES=
